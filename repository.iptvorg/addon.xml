<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.iptvorg"
       name="IPTV-org Repo"
       version="1.0.0"
       provider-name="psherrera">
    <extension point="xbmc.addon.repository" name="IPTV-org Repo">
        <dir>
            <info compressed="false">https://psherrera.github.io/kodi-iptvorg/addons.xml</info>
            <checksum>https://psherrera.github.io/kodi-iptvorg/addons.xml.md5</checksum>
            <datadir zip="true">https://psherrera.github.io/kodi-iptvorg/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_ES">Repositorio de actualizaciones para el addon IPTV-org</summary>
        <summary lang="en_GB">Update repository for the IPTV-org add-on</summary>
        <description lang="es_ES">Instalá este repositorio una vez y Kodi te ofrecerá automáticamente las nuevas versiones del addon IPTV-org.</description>
        <description lang="en_GB">Install this repository once and Kodi will automatically offer new versions of the IPTV-org add-on.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
